#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    int key[2][2] = {
        {9, 4},
        {5, 7}
    };

    int inverse[2][2] = {
        {5, 12},
        {15, 25}
    };

    char plaintext[] =
        "meet me at the usual place at ten rather than eight oclock";

    char text[200], encrypted[200], decrypted[200];

    int i, n = 0, k = 0;

    for(i = 0; plaintext[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)plaintext[i]))
        {
            text[n++] = toupper((unsigned char)plaintext[i]);
        }
    }
    if(n % 2 != 0)
        text[n++] = 'X';

    text[n] = '\0';

    // Encryption
    for(i = 0; i < n; i += 2)
    {
        int a = text[i] - 'A';
        int b = text[i + 1] - 'A';

        int c1 = (key[0][0] * a + key[0][1] * b) % 26;
        int c2 = (key[1][0] * a + key[1][1] * b) % 26;

        encrypted[k++] = c1 + 'A';
        encrypted[k++] = c2 + 'A';
    }

    encrypted[k] = '\0';

    printf("Original Plaintext:\n%s\n", plaintext);

    printf("\nPrepared Plaintext:\n%s\n", text);

    printf("\nEncrypted Ciphertext:\n");

    for(i = 0; i < k; i++)
    {
        printf("%c", encrypted[i]);

        if((i + 1) % 4 == 0)
            printf(" ");
    }

    printf("\n");

    for(i = 0; i < k; i += 2)
    {
        int a = encrypted[i] - 'A';
        int b = encrypted[i + 1] - 'A';

        int p1 = (inverse[0][0] * a +
                  inverse[0][1] * b) % 26;

        int p2 = (inverse[1][0] * a +
                  inverse[1][1] * b) % 26;

        decrypted[i] = p1 + 'A';
        decrypted[i + 1] = p2 + 'A';
    }

    decrypted[k] = '\0';

    printf("\nDecrypted Plaintext:\n%s\n", decrypted);

    return 0;
}
