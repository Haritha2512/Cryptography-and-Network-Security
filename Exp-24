#include <stdio.h>

long long extendedGCD(long long a, long long b,
                      long long *x, long long *y)
{
    if (b == 0) {
        *x = 1;
        *y = 0;
        return a;
    }

    long long x1, y1;
    long long gcd = extendedGCD(b, a % b, &x1, &y1);

    *x = y1;
    *y = x1 - (a / b) * y1;

    return gcd;
}

int main()
{
    long long e = 31;
    long long n = 3599;
    long long p = 0, q = 0;

    for (long long i = 2; i * i <= n; i++) {
        if (n % i == 0) {
            p = i;
            q = n / i;
            break;
        }
    }

    long long phi = (p - 1) * (q - 1);
    long long x, y;
    extendedGCD(e, phi, &x, &y);
    long long d = (x % phi + phi) % phi;

    printf("RSA PRIVATE KEY CALCULATION\n");
    printf("----------------------------\n");
    printf("Public exponent (e) = %lld\n", e);
    printf("Modulus (n)         = %lld\n", n);

    printf("\nPrime factors:\n");
    printf("p = %lld\n", p);
    printf("q = %lld\n", q);

    printf("\nEuler's Totient:\n");
    printf("phi(n) = %lld\n", phi);

    printf("\nPrivate Key:\n");
    printf("d = %lld\n", d);

    printf("\nPrivate Key = (%lld, %lld)\n", d, n);

    return 0;
}
