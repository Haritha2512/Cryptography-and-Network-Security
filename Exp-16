#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <time.h>

#define MAX 5000
#define CANDIDATES 10
#define TRIALS 3000

double english[26] = {
    8.12, 1.49, 2.71, 4.32, 12.02,
    2.30, 2.03, 5.92, 6.95, 0.10,
    0.69, 3.98, 2.61, 6.95, 7.68,
    1.82, 0.11, 6.02, 6.28, 9.10,
    2.88, 1.11, 2.09, 0.17, 2.11, 0.07
};

typedef struct {
    char text[MAX];
    double score;
} Result;

void decrypt(char cipher[], char plain[], int key[])
{
    int i;

    for(i = 0; cipher[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)cipher[i]))
        {
            int c = toupper((unsigned char)cipher[i]) - 'A';
            plain[i] = 'A' + key[c];
        }
        else
        {
            plain[i] = cipher[i];
        }
    }

    plain[i] = '\0';
}

double calculateScore(char text[])
{
    int count[26] = {0};
    int total = 0;
    int i;

    double score = 0.0;

    for(i = 0; text[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)text[i]))
        {
            count[toupper((unsigned char)text[i]) - 'A']++;
            total++;
        }
    }

    if(total == 0)
        return 1e100;

    for(i = 0; i < 26; i++)
    {
        double actual = (double)count[i] * 100 / total;
        double difference = actual - english[i];

        score += difference * difference;
    }

    return score;
}

void randomKey(int key[])
{
    int i, j, temp;

    for(i = 0; i < 26; i++)
        key[i] = i;

    for(i = 25; i > 0; i--)
    {
        j = rand() % (i + 1);

        temp = key[i];
        key[i] = key[j];
        key[j] = temp;
    }
}

void improveKey(char cipher[], int key[])
{
    char plain[MAX];

    int improved = 1;

    double bestScore;

    decrypt(cipher, plain, key);
    bestScore = calculateScore(plain);

    while(improved)
    {
        improved = 0;

        for(int i = 0; i < 26; i++)
        {
            for(int j = i + 1; j < 26; j++)
            {
                int temp = key[i];
                key[i] = key[j];
                key[j] = temp;

                decrypt(cipher, plain, key);

                double newScore = calculateScore(plain);

                if(newScore < bestScore)
                {
                    bestScore = newScore;
                    improved = 1;
                }
                else
                {
                    temp = key[i];
                    key[i] = key[j];
                    key[j] = temp;
                }
            }
        }
    }
}

int duplicate(Result results[], int count, char text[])
{
    for(int i = 0; i < count; i++)
    {
        if(strcmp(results[i].text, text) == 0)
            return 1;
    }

    return 0;
}

// Insert candidate in sorted order
void insertResult(Result results[], int *count,
                  char text[], double score, int top)
{
    if(duplicate(results, *count, text))
        return;

    int pos = 0;

    while(pos < *count && results[pos].score <= score)
        pos++;

    if(pos >= top)
        return;

    int limit = (*count < top) ? *count : top - 1;

    for(int i = limit; i > pos; i--)
        results[i] = results[i - 1];

    strcpy(results[pos].text, text);
    results[pos].score = score;

    if(*count < top)
        (*count)++;
}

int main()
{
    char cipher[MAX];
    char plain[MAX];

    Result results[CANDIDATES];

    int key[26];
    int top, count = 0;

    srand((unsigned int)time(NULL));

    printf("Enter ciphertext:\n");
    fgets(cipher, MAX, stdin);

    printf("Enter number of top plaintexts (1-10): ");
    scanf("%d", &top);

    if(top < 1 || top > 10)
    {
        printf("Invalid number of candidates.\n");
        return 1;
    }

    for(int trial = 0; trial < TRIALS; trial++)
    {
        randomKey(key);

        improveKey(cipher, key);

        decrypt(cipher, plain, key);

        double score = calculateScore(plain);

        insertResult(results, &count, plain, score, top);
    }

    printf("\nTop Possible Plaintexts:\n\n");

    for(int i = 0; i < count; i++)
    {
        printf("Rank %d\n", i + 1);
        printf("Frequency Score: %.2f\n", results[i].score);
        printf("Plaintext: %s\n\n", results[i].text);
    }

    printf("Total candidates found: %d\n", count);

    return 0;
}
