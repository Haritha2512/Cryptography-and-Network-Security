#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char key[] = "ROYAL NEW ZEALAND NAVY";
    char cipher[] =
    "KXJEY UREBE ZWEHE WRYTU HEYFS "
    "KREHE GOYFI WTTTU OLKSY CAJPO "
    "BOTEI ZONTX BYBNT GONEY CUZWR "
    "GDSON SXBOU YWRHE BAAHY USEDQ";

    char matrix[5][5];
    int used[26] = {0};
    int i, j, k = 0;

    // Generate 5x5 Playfair matrix
    for (i = 0; key[i] != '\0'; i++)
    {
        char ch = toupper(key[i]);

        if (ch == 'J')
            ch = 'I';

        if (ch >= 'A' && ch <= 'Z' &&
            !used[ch - 'A'])
        {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }

    for (i = 0; i < 26; i++)
    {
        if (i == ('J' - 'A'))
            continue;

        if (!used[i])
        {
            matrix[k / 5][k % 5] = 'A' + i;
            used[i] = 1;
            k++;
        }
    }

    printf("Playfair Key Matrix:\n");

    for (i = 0; i < 5; i++)
    {
        for (j = 0; j < 5; j++)
            printf("%c ", matrix[i][j]);

        printf("\n");
    }

    printf("\nDecrypted Message:\n");

    char text[200];
    int n = 0;

    for (i = 0; cipher[i] != '\0'; i++)
    {
        if (isalpha((unsigned char)cipher[i]))
        {
            char ch = toupper((unsigned char)cipher[i]);

            if (ch == 'J')
                ch = 'I';

            text[n++] = ch;
        }
    }

    for (i = 0; i < n - 1; i += 2)
    {
        int r1, c1, r2, c2;

        for (j = 0; j < 25; j++)
        {
            if (matrix[j / 5][j % 5] == text[i])
            {
                r1 = j / 5;
                c1 = j % 5;
            }

            if (matrix[j / 5][j % 5] == text[i + 1])
            {
                r2 = j / 5;
                c2 = j % 5;
            }
        }

        if (r1 == r2)
        {
            printf("%c%c",
                matrix[r1][(c1 + 4) % 5],
                matrix[r2][(c2 + 4) % 5]);
        }
        else if (c1 == c2)
        {
            printf("%c%c",
                matrix[(r1 + 4) % 5][c1],
                matrix[(r2 + 4) % 5][c2]);
        }
        else
        {
            printf("%c%c",
                matrix[r1][c2],
                matrix[r2][c1]);
        }
    }
    printf("\n");

    return 0;
}
