#include <stdio.h>
#include <wchar.h>
#include <locale.h>

wchar_t decrypt_char(wchar_t c) {
    switch (c) {
        case L'5': return L'a';
        case L'2': return L'b';
        case L'—': return L'c'; 
        case L'-': return L'c'; 
        case L'†': return L'd';
        case L'8': return L'e';
        case L'1': return L'f';
        case L'3': return L'g';
        case L'4': return L'h';
        case L'6': return L'i';
        case L'0': return L'l';
        case L'9': return L'm';
        case L'*': return L'n';
        case L'‡': return L'o';
        case L'.': return L'p';
        case L'(': return L'r';
        case L')': return L's';
        case L';': return L't';
        case L'?': return L'u';
        case L'¶': return L'v';
        case L']': return L'w';
        case L':': return L'y';
        default:   return c;    
    }
}

