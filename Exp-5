#include <stdio.h>
#include <ctype.h>

int main()
{
    char text[100];
    int a, b, i;

    printf("Enter plaintext: ");
    scanf("%99s", text);

    printf("Enter values of a and b: ");
    scanf("%d %d", &a, &b);

    if (a < 1 || a > 25)
    {
        printf("Invalid value of a!");
        return 0;
    }

    for (i = 0; text[i] != '\0'; i++)
    {
        if (isupper(text[i]))
            text[i] = ((a * (text[i] - 'A') + b) % 26) + 'A';
        else if (islower(text[i]))
            text[i] = ((a * (text[i] - 'a') + b) % 26) + 'a';
    }

    printf("Encrypted text: %s\n", text);

    return 0;
}
