#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char matrix[5][5] = {
        {'M','F','H','I','K'},
        {'U','N','O','P','Q'},
        {'Z','V','W','X','Y'},
        {'E','L','A','R','G'},
        {'D','S','T','B','C'}
    };

    char plaintext[] =
        "Must see you over Cadogan West. Coming at once.";

    char text[200], encrypted[200];
    int i, j, k = 0, n = 0;

    for(i = 0; plaintext[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)plaintext[i]))
        {
            char ch = toupper((unsigned char)plaintext[i]);

            if(ch == 'J')
                ch = 'I';

            text[n++] = ch;
        }
    }

    text[n] = '\0';

    char prepared[200];
    k = 0;

    for(i = 0; i < n; )
    {
        char a = text[i++];
        char b;

        if(i >= n)
            b = 'X';
        else if(text[i] == a)
            b = 'X';
        else
            b = text[i++];

        prepared[k++] = a;
        prepared[k++] = b;
    }

    prepared[k] = '\0';

    k = 0;

    for(i = 0; prepared[i] != '\0'; i += 2)
    {
        int r1, c1, r2, c2;

        for(j = 0; j < 25; j++)
        {
            if(matrix[j/5][j%5] == prepared[i])
            {
                r1 = j/5;
                c1 = j%5;
            }

            if(matrix[j/5][j%5] == prepared[i+1])
            {
                r2 = j/5;
                c2 = j%5;
            }
        }

        if(r1 == r2)
        {
            encrypted[k++] = matrix[r1][(c1+1)%5];
            encrypted[k++] = matrix[r2][(c2+1)%5];
        }
        else if(c1 == c2)
        {
            encrypted[k++] = matrix[(r1+1)%5][c1];
            encrypted[k++] = matrix[(r2+1)%5][c2];
        }
        else
        {
            encrypted[k++] = matrix[r1][c2];
            encrypted[k++] = matrix[r2][c1];
        }
    }

    encrypted[k] = '\0';

    printf("Plaintext: %s\n", plaintext);
    printf("Prepared Text: %s\n", prepared);
    printf("Encrypted Text: ");

    for(i = 0; i < k; i++)
    {
        printf("%c", encrypted[i]);

        if((i+1)%5 == 0)
            printf(" ");
    }

    printf("\n");

    return 0;
}
