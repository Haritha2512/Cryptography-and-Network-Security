#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char plaintext[] = "send more money";
    char required[] = "cash not needed";

    int key[] = {
        9, 0, 1, 7, 23, 15, 21,
        14, 11, 11, 2, 8, 9
    };

    int newkey[13];
    char cipher[14];
    char decrypted[14];

    int i, j = 0;
    int p, c, r;

    printf("Original Plaintext: %s\n", plaintext);

    for(i = 0; plaintext[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)plaintext[i]))
        {
            p = tolower((unsigned char)plaintext[i]) - 'a';

            c = (p + key[j]) % 26;

            cipher[j] = c + 'A';
            j++;
        }
    }

    cipher[j] = '\0';

    printf("\nGiven Key Stream:\n");

    for(i = 0; i < 13; i++)
        printf("%d ", key[i]);

    printf("\n\nEncrypted Ciphertext: %s\n", cipher);

    // Part B: Find a new key
    j = 0;

    for(i = 0; required[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)required[i]))
        {
            p = tolower((unsigned char)required[i]) - 'a';
            c = cipher[j] - 'A';

            newkey[j] = (c - p + 26) % 26;

            j++;
        }
    }

    printf("\nNew Key Stream:\n");

    for(i = 0; i < 13; i++)
        printf("%d ", newkey[i]);

    for(i = 0; i < 13; i++)
    {
        c = cipher[i] - 'A';

        r = (c - newkey[i] + 26) % 26;

        decrypted[i] = r + 'A';
    }

    decrypted[13] = '\0';

    printf("\n\nDecrypted Plaintext: ");

    j = 0;

    for(i = 0; required[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)required[i]))
        {
            printf("%c", decrypted[j++]);
        }
        else
        {
            printf("%c", required[i]);
        }
    }

    printf("\n");

    return 0;
}
