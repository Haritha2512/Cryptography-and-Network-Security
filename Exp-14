#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <time.h>

int main()
{
    char plaintext[100];
    char ciphertext[100];
    char decrypted[100];
    int key[100];
    int i, n = 0;

    printf("Enter plaintext: ");
    fgets(plaintext, sizeof(plaintext), stdin);

    for(i = 0; plaintext[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)plaintext[i]))
            n++;
    }

    srand(time(NULL));

    printf("\nRandom Key: ");

    for(i = 0; i < n; i++)
    {
        key[i] = rand() % 26;
        printf("%d ", key[i]);
    }

    int j = 0;

    for(i = 0; plaintext[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)plaintext[i]))
        {
            int p = toupper((unsigned char)plaintext[i]) - 'A';

            int c = (p + key[j]) % 26;

            ciphertext[i] = c + 'A';
            j++;
        }
        else
        {
            ciphertext[i] = plaintext[i];
        }
    }

    ciphertext[i] = '\0';

    printf("\n\nEncrypted Text: %s", ciphertext);

    j = 0;

    for(i = 0; ciphertext[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)ciphertext[i]))
        {
            int c = ciphertext[i] - 'A';

            int p = (c - key[j] + 26) % 26;

            decrypted[i] = p + 'A';
            j++;
        }
        else
        {
            decrypted[i] = ciphertext[i];
        }
    }

    decrypted[i] = '\0';

    printf("\nDecrypted Text: %s", decrypted);

    return 0;
}
