#include <stdio.h>
#include <string.h>
#include <ctype.h>
#define MAX 5000

double englishFreq[26] = {
    8.167, 1.492, 2.782, 4.253, 12.702,
    2.228, 2.015, 6.094, 6.966, 0.153,
    0.772, 4.025, 2.406, 6.749, 7.507,
    1.929, 0.095, 5.987, 6.327, 9.056,
    2.758, 0.978, 2.360, 0.150, 1.974, 0.074
};

typedef struct {
    int key;
    double score;
    char plaintext[MAX];
} Candidate;

void decrypt(char cipher[], char plain[], int key)
{
    int i;

    for (i = 0; cipher[i] != '\0'; i++) {
        if (isalpha((unsigned char)cipher[i])) {
            char base = isupper((unsigned char)cipher[i])
                        ? 'A' : 'a';

            plain[i] = (char)(base +
                (cipher[i] - base - key + 26) % 26);
        }
        else {
            plain[i] = cipher[i];
        }
    }

    plain[i] = '\0';
}

double calculateScore(char text[])
{
    int count[26] = {0};
    int total = 0;

    for (int i = 0; text[i] != '\0'; i++) {
        if (isalpha((unsigned char)text[i])) {
            count[toupper((unsigned char)text[i]) - 'A']++;
            total++;
        }
    }

    if (total == 0)
        return 1e9;

    double score = 0.0;

    for (int i = 0; i < 26; i++) {
        double expected = total * englishFreq[i] / 100.0;
        double difference = count[i] - expected;

        score += (difference * difference) /
                 (expected + 0.0001);
    }

    return score;
}

int main()
{
    char ciphertext[MAX];
    Candidate candidates[26];
    int top;

    printf("ADDITIVE CIPHER FREQUENCY ATTACK\n");
    printf("--------------------------------\n");

    printf("Enter ciphertext:\n");

    if (fgets(ciphertext, sizeof(ciphertext), stdin) == NULL)
        return 1;

    ciphertext[strcspn(ciphertext, "\n")] = '\0';

    printf("Enter number of possible plaintexts (1-26): ");

    if (scanf("%d", &top) != 1 || top < 1 || top > 26) {
        printf("Invalid number. Enter a value from 1 to 26.\n");
        return 1;
    }

    for (int key = 0; key < 26; key++) {
        candidates[key].key = key;

        decrypt(ciphertext, candidates[key].plaintext, key);

        candidates[key].score =
            calculateScore(candidates[key].plaintext);
    }

    for (int i = 0; i < 25; i++) {
        for (int j = i + 1; j < 26; j++) {
            if (candidates[j].score < candidates[i].score) {
                Candidate temp = candidates[i];
                candidates[i] = candidates[j];
                candidates[j] = temp;
            }
        }
    }

    printf("\nTOP %d POSSIBLE PLAINTEXTS\n", top);
    printf("--------------------------\n");

    for (int i = 0; i < top; i++) {
        printf("\nCandidate %d\n", i + 1);
        printf("Key: %d\n", candidates[i].key);
        printf("Score: %.3f\n", candidates[i].score);
        printf("Plaintext: %s\n", candidates[i].plaintext);
    }

    return 0;
}
