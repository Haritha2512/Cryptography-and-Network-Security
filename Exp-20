#include <stdio.h>
#define N 5

int main()
{
    int i;

    int ecb[N] = {0};
    int cbc[N] = {0};
    int source[N] = {0};

    printf("ERROR IN TRANSMITTED CIPHERTEXT C1\n");

    ecb[0] = 1;
    cbc[0] = 1;
    cbc[1] = 1;

    printf("\nECB Mode:\n");

    for(i = 0; i < N; i++)
        printf("P%d: %s\n", i+1,
               ecb[i] ? "CORRUPTED" : "UNAFFECTED");

    printf("\nCBC Mode:\n");

    for(i = 0; i < N; i++)
        printf("P%d: %s\n", i+1,
               cbc[i] ? "CORRUPTED" : "UNAFFECTED");

    printf("\n\nERROR IN SOURCE PLAINTEXT P1\n");

    for(i = 0; i < N; i++)
        source[i] = 1;

    printf("\nCBC Encryption:\n");

    for(i = 0; i < N; i++)
        printf("C%d: %s\n", i+1,
               source[i] ? "CHANGED" : "UNCHANGED");

    printf("\nAt Receiver:\n");

    for(i = 0; i < N; i++)
        printf("P%d: %s\n", i+1,
               source[i] ? "CORRUPTED" : "UNAFFECTED");

    return 0;
}
