#include <stdio.h>
#include <math.h>

int main()
{
    long double fact = 1.0;
    int i;

    for(i = 1; i <= 25; i++)
    {
        fact = fact * i;
    }
    
    printf("Total possible Playfair keys:\n");
    printf("%.0Lf\n", fact);

    printf("Approximate power of 2: 2^%.2Lf\n",
           log2l(fact));

    long double unique = fact / 4.0;

    printf("\nEffectively unique Playfair keys:\n");
    printf("%.0Lf\n", unique);

    printf("Approximate power of 2: 2^%.2Lf\n",
           log2l(unique));

    return 0;
}
