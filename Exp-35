#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char plaintext[100];
    char ciphertext[100];
    char decrypted[100];

    int key[] = {3, 19, 5, 11, 7};

    int length;

    printf("ONE-TIME PAD VIGENERE CIPHER\n");
    printf("---------------------------\n");

    printf("Enter plaintext: ");
    scanf("%99s", plaintext);

    length = strlen(plaintext);

    if (length > 5) {
        printf("Key stream is too short!\n");
        return 1;
    }

    printf("\nPlaintext: %s\n", plaintext);

    printf("Key stream: ");
    for (int i = 0; i < length; i++)
        printf("%d ", key[i]);

    for (int i = 0; i < length; i++) {
        int p = toupper((unsigned char)plaintext[i]) - 'A';

        if (p < 0 || p > 25) {
            printf("\nOnly alphabetic characters are allowed.\n");
            return 1;
        }

        int c = (p + key[i]) % 26;
        ciphertext[i] = 'A' + c;
    }

    ciphertext[length] = '\0';

    printf("\n\nEncrypted ciphertext: %s\n", ciphertext);

    for (int i = 0; i < length; i++) {
        int c = ciphertext[i] - 'A';
        int p = (c - key[i] + 26) % 26;

        decrypted[i] = 'A' + p;
    }

    decrypted[length] = '\0';

    printf("Decrypted plaintext: %s\n", decrypted);

    return 0;
}
