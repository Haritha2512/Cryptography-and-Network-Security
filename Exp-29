#include <stdio.h>
#define STATE_LANES 25
#define RATE_LANES 16
#define CAPACITY_LANES 9

int main()
{
    int state[STATE_LANES] = {0};
    int i, blocks = 0;
    int allNonZero = 0;

    printf("SHA-3 CAPACITY LANE ANALYSIS\n");
    printf("----------------------------\n");

    printf("Total state size = 1600 bits\n");
    printf("Message block size = 1024 bits\n");
    printf("Rate lanes = %d\n", RATE_LANES);
    printf("Capacity lanes = %d\n", CAPACITY_LANES);

    for (i = 0; i < RATE_LANES; i++) {
        state[i] = 1;
    }

    printf("\nAfter absorbing first message block P0:\n");

    printf("Rate lanes: ");
    for (i = 0; i < RATE_LANES; i++) {
        printf("%d ", state[i]);
    }

    printf("\nCapacity lanes: ");
    for (i = RATE_LANES; i < STATE_LANES; i++) {
        printf("%d ", state[i]);
    }

    for (blocks = 1; blocks <= 100; blocks++) {
        for (i = 0; i < RATE_LANES; i++) {
            state[i] ^= 1;
        }

        allNonZero = 1;

        for (i = RATE_LANES; i < STATE_LANES; i++) {
            if (state[i] == 0) {
                allNonZero = 0;
                break;
            }
        }

        if (allNonZero)
            break;
    }

    printf("\n\nAfter processing message blocks:\n");

    if (allNonZero) {
        printf("All capacity lanes became nonzero.\n");
        printf("Number of blocks = %d\n", blocks);
    }
    else {
        printf("All capacity lanes are still zero.\n");
        printf("Permutation was ignored.\n");
        printf("Required number of blocks = INFINITY\n");
    }

    return 0;
}
