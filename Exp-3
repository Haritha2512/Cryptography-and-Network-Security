#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

void generateKey(char key[])
{
    int used[26] = {0}, i, j, k = 0;
    char ch;

    used['J' - 'A'] = 1;

    for (i = 0; key[i] != '\0'; i++)
    {
        ch = toupper(key[i]);
        if (ch >= 'A' && ch <= 'Z' && !used[ch - 'A'])
        {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }

    for (ch = 'A'; ch <= 'Z'; ch++)
    {
        if (!used[ch - 'A'])
        {
            matrix[k / 5][k % 5] = ch;
            k++;
        }
    }
}

void encrypt(char a, char b)
{
    int r1, c1, r2, c2, i, j;

    for (i = 0; i < 5; i++)
        for (j = 0; j < 5; j++)
        {
            if (matrix[i][j] == a)
                r1 = i, c1 = j;
            if (matrix[i][j] == b)
                r2 = i, c2 = j;
        }

    if (r1 == r2)
        printf("%c%c", matrix[r1][(c1 + 1) % 5],
                        matrix[r2][(c2 + 1) % 5]);
    else if (c1 == c2)
        printf("%c%c", matrix[(r1 + 1) % 5][c1],
                        matrix[(r2 + 1) % 5][c2]);
    else
        printf("%c%c", matrix[r1][c2], matrix[r2][c1]);
}

int main()
{
    char key[100], text[200], clean[200];
    int i, j = 0;

    printf("Enter keyword: ");
    scanf("%99s", key);

    printf("Enter plaintext: ");
    scanf("%199s", text);

    generateKey(key);

    for (i = 0; text[i] != '\0'; i++)
    {
        char ch = toupper(text[i]);
        if (ch >= 'A' && ch <= 'Z')
            clean[j++] = (ch == 'J') ? 'I' : ch;
    }
    clean[j] = '\0';

    if (j % 2 != 0)
        clean[j++] = 'X';

    printf("Encrypted text: ");
    for (i = 0; i < j; i += 2)
    {
        if (clean[i] == clean[i + 1])
            clean[i + 1] = 'X';

        encrypt(clean[i], clean[i + 1]);
    }

    printf("\n");
    return 0;
}
