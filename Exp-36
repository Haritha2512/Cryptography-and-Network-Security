#include <stdio.h>
#include <string.h>
#include <ctype.h>

int gcd(int a, int b)
{
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int modInverse(int a)
{
    for (int i = 1; i < 26; i++) {
        if ((a * i) % 26 == 1)
            return i;
    }
    return -1;
}

void encrypt(char plaintext[], char ciphertext[],
             int a, int b)
{
    int i;

    for (i = 0; plaintext[i] != '\0'; i++) {
        if (isalpha((unsigned char)plaintext[i])) {
            int p = toupper((unsigned char)plaintext[i]) - 'A';
            int c = (a * p + b) % 26;

            ciphertext[i] = 'A' + c;
        }
        else {
            ciphertext[i] = plaintext[i];
        }
    }

    ciphertext[i] = '\0';
}

void decrypt(char ciphertext[], char plaintext[],
             int a, int b)
{
    int inverse = modInverse(a);
    int i;

    for (i = 0; ciphertext[i] != '\0'; i++) {
        if (isalpha((unsigned char)ciphertext[i])) {
            int c = toupper((unsigned char)ciphertext[i]) - 'A';
            int p = (inverse * (c - b + 26)) % 26;

            plaintext[i] = 'A' + p;
        }
        else {
            plaintext[i] = ciphertext[i];
        }
    }

    plaintext[i] = '\0';
}

int main()
{
    char plaintext[100];
    char ciphertext[100];
    char decrypted[100];

    int a, b;

    printf("AFFINE CAESAR CIPHER\n");
    printf("--------------------\n");

    printf("Enter plaintext: ");
    fgets(plaintext, sizeof(plaintext), stdin);
    plaintext[strcspn(plaintext, "\n")] = '\0';

    printf("Enter value of a: ");
    scanf("%d", &a);

    printf("Enter value of b: ");
    scanf("%d", &b);

    if (gcd(a, 26) != 1) {
        printf("\nInvalid key!\n");
        printf("GCD(%d, 26) = %d\n", a, gcd(a, 26));
        printf("Encryption is not one-to-one.\n");
        printf("Decryption is impossible uniquely.\n");
        return 0;
    }

    b = (b % 26 + 26) % 26;

    printf("\nValid key.\n");
    printf("GCD(%d, 26) = 1\n", a);

    encrypt(plaintext, ciphertext, a, b);

    printf("\nEncrypted ciphertext: %s\n", ciphertext);

    decrypt(ciphertext, decrypted, a, b);

    printf("Decrypted plaintext: %s\n", decrypted);

    return 0;
}
