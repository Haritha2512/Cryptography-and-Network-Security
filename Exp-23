#include <stdio.h>
#include <stdint.h>

int P10[10] = {3,5,2,7,4,10,1,9,8,6};
int P8[8] = {6,3,7,4,8,5,10,9};

int IP[8] = {2,6,3,1,4,8,5,7};
int IP_INV[8] = {4,1,3,5,7,2,8,6};

int EP[8] = {4,1,2,3,2,3,4,1};
int P4[4] = {2,4,3,1};

int S0[4][4] = {
    {1,0,3,2},
    {3,2,1,0},
    {0,2,1,3},
    {3,1,3,2}
};

int S1[4][4] = {
    {0,1,2,3},
    {2,0,1,3},
    {3,0,1,0},
    {2,1,0,3}
};

int permute(int input, int *table, int n, int bits)
{
    int output = 0;

    for(int i = 0; i < n; i++)
    {
        output = (output << 1) |
                 ((input >> (bits-table[i])) & 1);
    }

    return output;
}

int leftShift(int value, int shifts)
{
    return ((value << shifts) |
            (value >> (5-shifts))) & 31;
}

void generateKeys(int key, int *K1, int *K2)
{
    int p = permute(key, P10, 10, 10);

    int left = (p >> 5) & 31;
    int right = p & 31;

    left = leftShift(left, 1);
    right = leftShift(right, 1);

    *K1 = permute((left << 5) | right, P8, 8, 10);

    left = leftShift(left, 2);
    right = leftShift(right, 2);

    *K2 = permute((left << 5) | right, P8, 8, 10);
}

int sbox(int input, int box[4][4])
{
    int row = ((input & 8) >> 2) | (input & 1);
    int col = (input >> 1) & 3;

    return box[row][col];
}

int fk(int input, int key)
{
    int left = (input >> 4) & 15;
    int right = input & 15;

    int expanded = permute(right, EP, 8, 4);
    expanded ^= key;

    int s0 = sbox((expanded >> 4) & 15, S0);
    int s1 = sbox(expanded & 15, S1);

    int combined = (s0 << 2) | s1;

    int p4 = permute(combined, P4, 4, 4);

    left ^= p4;

    return (left << 4) | right;
}

int encrypt(int plaintext, int K1, int K2)
{
    int value = permute(plaintext, IP, 8, 8);

    value = fk(value, K1);

    value = ((value & 15) << 4) | (value >> 4);

    value = fk(value, K2);

    return permute(value, IP_INV, 8, 8);
}

int decrypt(int ciphertext, int K1, int K2)
{
    int value = permute(ciphertext, IP, 8, 8);

    value = fk(value, K2);

    value = ((value & 15) << 4) | (value >> 4);

    value = fk(value, K1);

    return permute(value, IP_INV, 8, 8);
}

void printBinary(int value)
{
    for(int i = 7; i >= 0; i--)
        printf("%d", (value >> i) & 1);
}

int main()
{
    int key = 0b0111111101;

    int plaintext[3] = {
        0b00000001,
        0b00000010,
        0b00000100
    };

    int ciphertext[3];
    int recovered[3];

    int K1, K2;
    int counter = 0;

    generateKeys(key, &K1, &K2);

    printf("S-DES Counter Mode (CTR)\n");

    printf("\nKey: 0111111101");
    printf("\nInitial Counter: 00000000\n");

    printf("\nENCRYPTION:\n");

    for(int i = 0; i < 3; i++)
    {
        int stream = encrypt(counter, K1, K2);

        ciphertext[i] = plaintext[i] ^ stream;

        printf("\nCounter: ");
        printBinary(counter);

        printf("\nPlaintext: ");
        printBinary(plaintext[i]);

        printf("\nEncrypted Counter: ");
        printBinary(stream);

        printf("\nCiphertext: ");
        printBinary(ciphertext[i]);

        printf("\n");

        counter++;
    }

    printf("\nDECRYPTION:\n");

    counter = 0;

    for(int i = 0; i < 3; i++)
    {
        int stream = encrypt(counter, K1, K2);

        recovered[i] = ciphertext[i] ^ stream;

        printf("\nCounter: ");
        printBinary(counter);

        printf("\nCiphertext: ");
        printBinary(ciphertext[i]);

        printf("\nDecrypted Plaintext: ");
        printBinary(recovered[i]);

        printf("\n");

        counter++;
    }

    printf("\nFinal Recovered Plaintext:\n");

    for(int i = 0; i < 3; i++)
    {
        printBinary(recovered[i]);
        printf(" ");
    }

    printf("\n");

    return 0;
}
