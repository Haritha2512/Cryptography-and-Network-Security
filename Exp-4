#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char text[100], key[100];
    int i, j = 0, shift;

    printf("Enter plaintext: ");
    scanf("%99s", text);

    printf("Enter key: ");
    scanf("%99s", key);

    for (i = 0; text[i] != '\0'; i++)
    {
        if (isalpha(text[i]))
        {
            shift = toupper(key[j % strlen(key)]) - 'A';

            if (isupper(text[i]))
                text[i] = (text[i] - 'A' + shift) % 26 + 'A';
            else
                text[i] = (text[i] - 'a' + shift) % 26 + 'a';

            j++;
        }
    }

    printf("Encrypted text: %s\n", text);

    return 0;
}
