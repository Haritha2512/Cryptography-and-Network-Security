#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <stdlib.h>
#define MAX 1000

double englishFreq[26] = {
    8.12, 1.49, 2.71, 4.32, 12.02,
    2.30, 2.03, 5.92, 7.31, 0.10,
    0.69, 3.98, 2.61, 6.95, 7.68,
    1.82, 0.11, 6.02, 6.28, 9.10,
    2.88, 1.11, 2.09, 0.17, 2.11, 0.07
};

typedef struct {
    int key;
    double score;
    char text[MAX];
} Result;

void decrypt(char cipher[], char plain[], int key)
{
    int i;

    for(i = 0; cipher[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)cipher[i]))
        {
            char ch = toupper((unsigned char)cipher[i]);

            plain[i] = 'A' + (ch - 'A' - key + 26) % 26;
        }
        else
        {
            plain[i] = cipher[i];
        }
    }

    plain[i] = '\0';
}

double calculateScore(char text[])
{
    int count[26] = {0};
    int total = 0;
    int i;

    double score = 0.0;

    for(i = 0; text[i] != '\0'; i++)
    {
        if(isalpha((unsigned char)text[i]))
        {
            count[toupper((unsigned char)text[i]) - 'A']++;
            total++;
        }
    }

    if(total == 0)
        return 0;

    for(i = 0; i < 26; i++)
    {
        double actual = (double)count[i] / total * 100;

        score += (actual - englishFreq[i]) *
                 (actual - englishFreq[i]);
    }

    return score;
}

void sortResults(Result results[], int n)
{
    int i, j;

    Result temp;

    for(i = 0; i < n - 1; i++)
    {
        for(j = i + 1; j < n; j++)
        {
            if(results[i].score > results[j].score)
            {
                temp = results[i];
                results[i] = results[j];
                results[j] = temp;
            }
        }
    }
}

int main()
{
    char cipher[MAX];
    int top, i;

    Result results[26];

    printf("Enter ciphertext:\n");
    fgets(cipher, MAX, stdin);

    printf("Enter number of top possible plaintexts: ");
    scanf("%d", &top);

    if(top < 1 || top > 26)
    {
        printf("Enter a value between 1 and 26.\n");
        return 1;
    }

    for(i = 0; i < 26; i++)
    {
        results[i].key = i;

        decrypt(cipher, results[i].text, i);

        results[i].score = calculateScore(results[i].text);
    }

    sortResults(results, 26);

    printf("\nTop %d Possible Plaintexts:\n\n", top);

    for(i = 0; i < top; i++)
    {
        printf("Rank %d\n", i + 1);
        printf("Key: %d\n", results[i].key);
        printf("Score: %.2f\n", results[i].score);
        printf("Plaintext: %s\n\n", results[i].text);
    }

    return 0;
}
